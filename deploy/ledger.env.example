# production 設定範本。複製到 VM 的 /srv/ledger/config/ledger.env（owner ledger、權限 0600）後填值。
# 這個範本只放 placeholder 或空值，不得放任何真 secret；真檔不進 Git。
# 格式要同時相容 systemd EnvironmentFile 與 pydantic-settings：KEY=value，不加引號、不加 export。

APP_ENV=prod
DATABASE_URL=sqlite:////srv/ledger/data/ledger.db
# 在 VM 上現場產生，不要貼到其他地方：
#   /srv/ledger/venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_COOKIE_SECURE=true
LOG_DIR=/srv/ledger/logs
LOG_LEVEL=INFO

# --- 備份：production 不啟用（P3-6 scope decision，見 docs/deploy.md §0）---
# 網站不讀任何備份設定，所以 production 的 ledger.env 不需要、也不要填下面這些。
# 備份程式碼與 ledger-backup.service／timer 保留在 repo；未來若要啟用，再把這些設定取消註解並依
# ADR-008／ADR-009 配置。BACKUP_AGE_RECIPIENT、RCLONE_REMOTE、RCLONE_CONFIG 不設定也不影響 app 啟動。
# BACKUP_DIR=/srv/ledger/data/backups
# BACKUP_AGE_RECIPIENT=
# BACKUP_AGE_BIN=/usr/bin/age
# RCLONE_REMOTE=
# RCLONE_PATH=ledger-backups
# RCLONE_BIN=rclone
# RCLONE_CONFIG=/srv/ledger/config/rclone.conf
