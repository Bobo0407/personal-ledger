# 複製成 .env 後再填值；.env 不進 Git。

# 執行環境：dev / test / prod / demo
APP_ENV=dev

# SQLite 路徑。正式環境：sqlite:////srv/ledger/data/ledger.db（四個斜線＝絕對路徑）
DATABASE_URL=sqlite:///./data/ledger.db

# 用來簽 CSRF 權杖。產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# 本機用 http 時設 false；正式環境（Caddy HTTPS）必須是 true
SESSION_COOKIE_SECURE=false

# 應用程式日誌
LOG_DIR=./logs
LOG_LEVEL=INFO

# --- 備份（scripts/backup.py；備份程序不需要 SECRET_KEY）---
# 本機備份目錄（預設在 data/ 底下，不進 Git）
BACKUP_DIR=./data/backups
# age 公鑰（age1…）。由 age-keygen 產生；私鑰請存在密碼管理員，不要放在這台機器或這個檔案
BACKUP_AGE_RECIPIENT=
# age 執行檔；不在 PATH 時填完整路徑
BACKUP_AGE_BIN=age

# --- 雲端備份（P3-5B；用 rclone 上傳到 Google Drive）---
# RCLONE_REMOTE 沒設定、又沒有 --local-only 時，backup.py 會失敗（不會默默只做本機備份）
# rclone 設定檔（rclone.conf）含 OAuth token，視為 secret：不進 Git、不貼到任何地方
RCLONE_REMOTE=
RCLONE_PATH=ledger-backups
RCLONE_BIN=rclone
# rclone.conf 的路徑（選填；不填就用 rclone 的預設位置）。正式排程的服務帳號建議明確指定
# RCLONE_CONFIG=
