# 複製成 .env 後再填值；.env 不進 Git。

# 執行環境：dev / test / prod / demo
APP_ENV=dev

# SQLite 路徑。正式環境：sqlite:////srv/ledger/data/ledger.db（四個斜線＝絕對路徑）
DATABASE_URL=sqlite:///./data/ledger.db

# 用來簽 CSRF 權杖。產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# 本機用 http 時設 false；正式環境（Caddy HTTPS）必須是 true
SESSION_COOKIE_SECURE=false

# 應用程式日誌
LOG_DIR=./logs
LOG_LEVEL=INFO
